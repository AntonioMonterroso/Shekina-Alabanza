# Copia este archivo a .env.local y pon los datos de tu proyecto Supabase (Settings → API).
# Solo la anon key va aquí. La service_role NUNCA va en el frontend ni en el repo.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# Slug del grupo cuya página pública abre el botón "Ver público" del login
VITE_SLUG_PUBLICO=alabanza
